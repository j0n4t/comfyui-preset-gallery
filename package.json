{
  "name": "comfyui-preset-gallery",
  "version": "1.0.0",
  "description": "A sleek, visual extension for ComfyUI to save, organize, filter, and reuse your favorite prompt snippets and style templates using an interactive embedded grid.",
  "main": "index.js",
  "scripts": {
    "test": "node --test \"tests/unit/**/*.test.ts\"",
    "test:py": "uv run --with pytest pytest",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "screenshot": "node scripts/screenshot.mjs",
    "profile": "node scripts/profile.mjs",
    "verify": "npm run lint && npm test && npm run test:py",
    "lint": "npm run lint:eslint && npm run typecheck",
    "lint:eslint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/j0n4t/comfyui-preset-gallery.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/j0n4t/comfyui-preset-gallery/issues"
  },
  "homepage": "https://github.com/j0n4t/comfyui-preset-gallery#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^25.9.9",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "jsdom": "^30.1.3",
    "prettier": "3.8.3",
    "typescript-eslint": "^8.60.1"
  }
}
